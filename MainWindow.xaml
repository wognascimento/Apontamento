<Window x:Class="Apontamento.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Apontamento" 
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        mc:Ignorable="d"
        Title="SISTEMA INTEGRADO DE GERENCIAMENTO - APONTAMENTO"
        Height="450" Width="800" WindowState="Maximized">
    
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <telerik:RadMenu
            Grid.Row="0" 
            VerticalAlignment="Center">

            <telerik:RadMenuItem Header="Produção">
                <telerik:RadMenuItem x:Name="DigitarProducao" Header="Apontar">
                    <telerik:RadMenuItem Header="Funcionário" Click="OnDigitarApontamentoProducaoFuncionarioClick"/>
                    <telerik:RadMenuItem Header="Semana" Click="OnDigitarApontamentoProducaoSemanaClick"/>
                    <telerik:RadMenuItem Header="Setor" Click="OnDigitarApontamentoProducaoSetorClick"/>
                </telerik:RadMenuItem>
                <telerik:RadMenuItem x:Name="ImprimirProducao" Header="Imprimir Ficha" Click="OnImprimirProducaoClick"/>
                <telerik:RadMenuItem Header="Consultas">
                    <telerik:RadMenuItem Header="Furo" Click="OnFuroProducaoClick"/>
                    <telerik:RadMenuItem Header="Apontamentos" Click="OnApontamentosProducaoClick"/>
                    <telerik:RadMenuItem Header="Setores" Click="OnSetoresProducaoClick"/>
                    <telerik:RadMenuItem Header="Funcioários">
                        <telerik:RadMenuItem x:Name="funcionarioControle" Header="Controle P.C.P" Click="OnControleFuncionarioPCP"/>
                        <telerik:RadMenuItem x:Name="funcionarioPresenteSemana" Header="Presentes Semana" Click="OnFuncionariosPresentes"/>
                        <telerik:RadMenuItem x:Name="funcionarioPresenteMes" Header="Presentes Mês" Click="OnFuncionariosPresentesMes"/>
                    </telerik:RadMenuItem>
                </telerik:RadMenuItem>
                
            </telerik:RadMenuItem>


            <telerik:RadMenuItem Header="Projetos">
                <telerik:RadMenuItem Header="Cadastro Funcionário" Click="OnApontamentoCadastroFuncionarioProjetosClick"/>
                <telerik:RadMenuItem x:Name="DigitarProjetos" Header="Apontar" Click="OnDigitarApontamentoProjetosClick"/>
                <telerik:RadMenuItem Header="Consultas">
                    <telerik:RadMenuItem Header="Pendência" Click="OnApontamentoProjetosFuroClick"/>
                    <telerik:RadMenuItem Header="Geral" Click="OnApontamentoProjetosGeralClick"/>
                    <telerik:RadMenuItem Header="Atividades" Click="OnApontamentoProjetosAtividadesClick"/>
                    <telerik:RadMenuItem Header="Atividades Centro de Custo" Click="OnApontamentoProjetosAtividadesCentroCustoClick"/>
                    <telerik:RadMenuItem Header="Atividades Funcionário" Click="OnApontamentoProjetosAtividadesFuncionarioClick"/>
                    <telerik:RadMenuItem Header="Atividades Cliente" Click="OnApontamentoProjetosAtividadesClienteClick"/>
                </telerik:RadMenuItem>
            </telerik:RadMenuItem>
            

            <telerik:RadMenuItem Header="Artes">
                <telerik:RadMenuItem Header="Cadastro Funcionário" Click="OnApontamentoCadastroFuncionarioArtesClick"/>
                <telerik:RadMenuItem x:Name="DigitarArtes" Header="Apontar" Click="OnDigitarApontamentoArtesClick"/>
                <telerik:RadMenuItem Header="Consultas">
                    <telerik:RadMenuItem Header="Pendência" Click="OnApontamentoArtesFuroClick"/>
                    <telerik:RadMenuItem Header="Geral" Click="OnApontamentoArtesGeralClick"/>
                    <telerik:RadMenuItem Header="Atividades" Click="OnApontamentoArtesAtividadesClick"/>
                    <telerik:RadMenuItem Header="Atividades Centro de Custo" Click="OnApontamentoArtesAtividadesCentroCustoClick"/>
                    <telerik:RadMenuItem Header="Atividades Funcionário" Click="OnApontamentoArtesAtividadesFuncionarioClick"/>
                    <telerik:RadMenuItem Header="Atividades Cliente" Click="OnApontamentoArtesAtividadesClienteClick"/>
                </telerik:RadMenuItem>
            </telerik:RadMenuItem>

            <telerik:RadMenuItem Header="Outros">
                <telerik:RadMenuItem Header="Atualizar Sistema" Click="OnAtualizarSistemaClick"/>
                <telerik:RadMenuItem Header="Sobre" Click="OnSobreSistemaClick"/>
            </telerik:RadMenuItem>

        </telerik:RadMenu>

        <telerik:RadDocking Grid.Row="1" x:Name="radDocking" HasDocumentHost="True">
            <telerik:RadDocking.DocumentHost>
                <telerik:RadSplitContainer>
                    <telerik:RadPaneGroup x:Name="documentGroup"/>
                </telerik:RadSplitContainer>
            </telerik:RadDocking.DocumentHost>
        </telerik:RadDocking>


        <StatusBar Grid.Row="2">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="4*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <StatusBarItem>
                <Image Source="/icones/icons8-usu_0025c3_0025a1rio-de-g_0025c3_0025aanero-neutro-windows-metro-16.png" Width="16" Height="16" MouseDown="OnAlterarUsuario"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="1">
                <TextBlock x:Name="txtUsername"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="2">
                <telerik:RadProgressBar x:Name="PbLoading" Height="20" Value="80" Width="100" IsIndeterminate="True" Visibility="Hidden"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="3">
                <Image Source="/icones/configuracao-de-dados-windows-metro-16.png" Width="16" Height="16" MouseDown="OnAlterarAno"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="4">
                <TextBlock x:Name="txtDataBase"/>
            </StatusBarItem>
        </StatusBar>

    </Grid>
    
</Window>
