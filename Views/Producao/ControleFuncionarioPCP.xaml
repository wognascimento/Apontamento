<UserControl
    x:Class="Apontamento.Views.Producao.ControleFuncionarioPCP"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="clr-namespace:Apontamento.Views.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Loaded="UserControl_Loaded"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converter:ConverterBoolen x:Key="ConverterBoolen" />
    </UserControl.Resources>

    <Grid>
        <telerik:RadGridView
            Margin="0,0,6,0"
            AutoGenerateColumns="False"
            CanUserDeleteRows="False"
            CanUserFreezeColumns="False"
            CanUserInsertRows="False"
            CanUserReorderColumns="True"
            CellEditEnded="OnCellEditEnded"
            IsFilteringAllowed="True"
            ItemsSource="{Binding Funcionarios}"
            RowIndicatorVisibility="Visible"
            SelectedItem="{Binding Funcionario, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            SelectionMode="Extended"
            SelectionUnit="FullRow"
            ShowGroupPanel="False">

            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn Header="codfun" IsReadOnly="True" DataMemberBinding="{Binding codfun}" />
                <telerik:GridViewDataColumn Header="nome_apelido" IsReadOnly="True" DataMemberBinding="{Binding nome_apelido}" />
                <telerik:GridViewDataColumn Header="apelido" IsReadOnly="True" DataMemberBinding="{Binding apelido}" />
                <telerik:GridViewDataColumn Header="setor" IsReadOnly="True" DataMemberBinding="{Binding setor}" />
                <telerik:GridViewDataColumn Header="sub_setor" IsReadOnly="True" DataMemberBinding="{Binding sub_setor}" />
                <telerik:GridViewDataColumn Header="funcao" IsReadOnly="True" DataMemberBinding="{Binding funcao}" />
                <telerik:GridViewDataColumn Header="empresa" IsReadOnly="True" DataMemberBinding="{Binding empresa}" />
                <telerik:GridViewCheckBoxColumn
                    Header="ativo"
                    UniqueName="ativo"
                    AutoSelectOnEdit="True"
                    DataMemberBinding="{Binding ativo, Converter={StaticResource ConverterBoolen}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <telerik:GridViewCheckBoxColumn
                    Header="exibir_furo"
                    UniqueName="exibir_furo"
                    AutoSelectOnEdit="True"
                    DataMemberBinding="{Binding exibir_furo, Converter={StaticResource ConverterBoolen}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <telerik:GridViewDataColumn Header="cidade" IsReadOnly="True" DataMemberBinding="{Binding cidade}" />
                <telerik:GridViewDataColumn Header="local" IsReadOnly="True" DataMemberBinding="{Binding local}" />
                <telerik:GridViewDataColumn Header="data_admissao" IsReadOnly="True" DataMemberBinding="{Binding data_admissao}" DataFormatString="{}{0:dd/MM/yyyy}" />
                <telerik:GridViewDataColumn Header="data_demissao" IsReadOnly="True" DataMemberBinding="{Binding data_demissao}" DataFormatString="{}{0:dd/MM/yyyy}" />
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>
    </Grid>
</UserControl>
