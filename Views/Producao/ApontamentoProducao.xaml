<UserControl
    x:Class="Apontamento.Views.Producao.ApontamentoProducao"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Loaded="UserControl_Loaded"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <StackPanel Margin="5">
                <TextBlock Text="Data" />
                <telerik:RadDatePicker
                    x:Name="dataApontamento"
                    Width="140"
                    SelectionChanged="dataApontamento_SelectionChanged" />
            </StackPanel>

            <StackPanel Margin="5">
                <TextBlock Text="Semana" />
                <telerik:RadWatermarkTextBox 
                    x:Name="SemanaApontamento"
                    Width="100"
                    IsEnabled="False"
                    TextAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="5">
            <TextBlock Text="Funcionário" />
            <telerik:RadComboBox
                x:Name="nomeFuncionario"
                Width="360"
                HorizontalAlignment="Left"
                DisplayMemberPath="nome_apelido"
                IsEditable="True"
                IsFilteringEnabled="True"
                IsTextSearchEnabled="True"
                ItemsSource="{Binding Funcionarios}"
                OpenDropDownOnFocus="True"
                SelectedItem="{Binding Funcionario, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                SelectionChanged="OnFuncionariosSelectionChanged" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <telerik:RadGridView
                x:Name="DGDigitacao"
                Grid.Column="0"
                Margin="0,0,6,0"
                AddingNewDataItem="DGDigitacao_AddingNewDataItem"
                AutoGenerateColumns="False"
                CanUserDeleteRows="False"
                CanUserInsertRows="True"
                GroupRenderMode="Flat"
                IsReadOnly="False"
                ItemsSource="{Binding Hts}"
                NewRowPosition="Bottom"
                RowIndicatorVisibility="Visible"
                RowValidated="DGDigitacao_RowValidated"
                SelectedItem="{Binding Ht, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                ShowGroupPanel="False">

                <telerik:RadGridView.Columns>
                    <telerik:GridViewDataColumn Header="OS" DataMemberBinding="{Binding num_os}" DataFormatString="{}{0:F0}" />
                    <telerik:GridViewDataColumn Header="HT" DataMemberBinding="{Binding quantidadehorastrabalhadas}" DataFormatString="{}{0:N2}" />
                    <telerik:GridViewDataColumn Header="COD" IsReadOnly="True" DataMemberBinding="{Binding cod}" DataFormatString="{}{0:F0}" />
                </telerik:RadGridView.Columns>
            </telerik:RadGridView>

            <telerik:RadGridView
                Grid.Column="1"
                Margin="5,0,0,0"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                ItemsSource="{Binding FutoHts}"
                MouseDoubleClick="DGFuro_MouseDoubleClick"
                RowIndicatorVisibility="Visible"
                SelectedItem="{Binding FuroHt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                ShowGroupPanel="False">

                <telerik:RadGridView.Columns>
                    <telerik:GridViewDataColumn Header="data_ideal" DataMemberBinding="{Binding data_ideal}" DataFormatString="{}{0:dd/MM/yyyy}" />
                    <telerik:GridViewDataColumn Header="ht_ideal" DataMemberBinding="{Binding ht_ideal}" DataFormatString="{}{0:N2}" />
                    <telerik:GridViewDataColumn Header="ht_furo" DataMemberBinding="{Binding ht_furo}" DataFormatString="{}{0:N2}" />
                </telerik:RadGridView.Columns>
            </telerik:RadGridView>
        </Grid>
    </Grid>
</UserControl>
