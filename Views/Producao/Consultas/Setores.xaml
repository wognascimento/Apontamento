<UserControl
    x:Class="Apontamento.Views.Producao.Consultas.Setores"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="clr-namespace:Apontamento.Views.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Loaded="UserControl_Loaded"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converter:ConverterBoolen x:Key="ConverterBoolen" />
    </UserControl.Resources>

    <Grid>
        <telerik:RadGridView ClipboardCopyMode="Cells,Header"
            Margin="0,0,6,0"
            AutoGenerateColumns="False"
            CanUserDeleteRows="False"
            CanUserFreezeColumns="False"
            CanUserInsertRows="False"
            CanUserReorderColumns="True"
            CellEditEnded="OnCellEditEnded"
            IsFilteringAllowed="True"
            ItemsSource="{Binding Setores}"
            RowIndicatorVisibility="Visible"
            SelectedItem="{Binding Setor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            ShowGroupPanel="False">

            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn
                    Header="codigo_setor"
                    IsReadOnly="True"
                    DataMemberBinding="{Binding codigo_setor}" 
                    DataFormatString="{}{0:F0}"/>
                <telerik:GridViewDataColumn
                    Header="setor"
                    IsReadOnly="True"
                    DataMemberBinding="{Binding setor}" />
                <telerik:GridViewDataColumn
                    Header="localizacao"
                    IsReadOnly="True"
                    DataMemberBinding="{Binding localizacao}" />
                <telerik:GridViewDataColumn
                    Header="galpao"
                    IsReadOnly="True"
                    DataMemberBinding="{Binding galpao}" />
                <telerik:GridViewDataColumn
                    Header="responsavel"
                    IsReadOnly="True"
                    DataMemberBinding="{Binding responsavel}" />
                <telerik:GridViewDataColumn
                    Header="lider"
                    IsReadOnly="True"
                    DataMemberBinding="{Binding lider}" />
                <telerik:GridViewCheckBoxColumn
                    Header="inativo"
                    UniqueName="inativo"
                    AutoSelectOnEdit="True"
                    DataMemberBinding="{Binding inativo, Converter={StaticResource ConverterBoolen}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>
    </Grid>
</UserControl>


