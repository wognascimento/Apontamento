<UserControl x:Class="Apontamento.Views.Projetos.CadastroFuncionarioMei"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Loaded="UserControl_Loaded">

    <Grid Margin="0,0,2,2">
        <telerik:RadGridView
            x:Name="dgFuncionariosMei"
            AutoGenerateColumns="False"
            CanUserDeleteRows="False"
            CanUserInsertRows="True"
            ClipboardCopyMode="Cells,Header"
            GroupRenderMode="Flat"
            IsReadOnly="False"
            ItemsSource="{Binding Funcionarios}"
            NewRowPosition="Bottom"
            AddingNewDataItem="dgFuncionariosMei_AddingNewDataItem"
            RowValidated="dgFuncionariosMei_RowValidated"
            RowValidating="dgFuncionariosMei_RowValidating"
            ShowGroupPanel="False">

            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn
                    DataMemberBinding="{Binding codfun}"
                    Header="Código"
                    IsReadOnly="True"
                    Width="90" />
                <telerik:GridViewDataColumn
                    DataMemberBinding="{Binding nome_apelido}"
                    Header="Nome/Apelido"
                    Width="260" />
                <telerik:GridViewDataColumn
                    DataMemberBinding="{Binding setor}"
                    Header="Setor"
                    IsReadOnly="True"
                    Width="160" />
                <telerik:GridViewDataColumn
                    DataMemberBinding="{Binding admissao}"
                    DataFormatString="{}{0:dd/MM/yyyy}"
                    Header="Admissão"
                    Width="110" />
                <telerik:GridViewDataColumn
                    DataMemberBinding="{Binding demissao}"
                    DataFormatString="{}{0:dd/MM/yyyy}"
                    Header="Demissão"
                    Width="110" />
                <telerik:GridViewDataColumn
                    DataMemberBinding="{Binding local_galpao}"
                    Header="Local Galpão"
                    IsReadOnly="True"
                    Width="110" />
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>
    </Grid>
</UserControl>
