<UserControl x:Class="Apontamento.Views.Projetos.CadastroFuncionarioProjetos"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Loaded="UserControl_Loaded">

    <Grid>
        <telerik:RadGridView
            x:Name="dgFuncionarios"
            AutoGenerateColumns="False"
            CanUserInsertRows="True"
            CanUserDeleteRows="False"
            CanUserResizeColumns="True"
            GroupRenderMode="Flat"
            IsReadOnly="False"
            ItemsSource="{Binding FuncProjetos}"
            NewRowPosition="Bottom"
            RowDetailsVisibilityMode="VisibleWhenSelected"
            SelectedItem="{Binding FuncProjeto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            AddingNewDataItem="dgFuncionarios_AddingNewDataItem"
            CellEditEnded="dgFuncionarios_CellEditEnded"
            RowValidated="dgFuncionarios_RowValidated"
            RowValidating="dgFuncionarios_RowValidating"
            ShowGroupPanel="False">

            <telerik:RadGridView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Apontar Ferias" Click="ApontarFerias_Click"/>
                    <MenuItem Header="Apontar nao trabalhada" Click="ApontarNaoTrabalhada_Click"/>
                </ContextMenu>
            </telerik:RadGridView.ContextMenu>

            <telerik:RadGridView.Columns>
                <telerik:GridViewComboBoxColumn
                    Header="Funcionario"
                    DataMemberBinding="{Binding cod_func}"
                    ItemsSource="{Binding DataContext.Funcs, RelativeSource={RelativeSource AncestorType=telerik:RadGridView}}"
                    SelectedValueMemberPath="codfun"
                    DisplayMemberPath="nome_apelido"
                    Width="350"/>
                <telerik:GridViewDataColumn Header="Login" DataMemberBinding="{Binding nick_name_func}"/>
                <telerik:GridViewDataColumn Header="Horas Minimas" DataMemberBinding="{Binding horas_minimas}" DataFormatString="{}{0:N2}"/>
                <telerik:GridViewDataColumn Header="Inicio Ferias" DataMemberBinding="{Binding incio_ferias}" DataFormatString="{}{0:dd/MM/yyyy}"/>
                <telerik:GridViewDataColumn Header="Termino Ferias" DataMemberBinding="{Binding termino_ferias}" DataFormatString="{}{0:dd/MM/yyyy}"/>
            </telerik:RadGridView.Columns>

            <telerik:RadGridView.RowDetailsTemplate>
                <DataTemplate>
                    <telerik:RadGridView
                        AutoGenerateColumns="False"
                        CanUserInsertRows="False"
                        CanUserDeleteRows="False"
                        CanUserResizeColumns="True"
                        IsReadOnly="False"
                        ItemsSource="{Binding PlanosProjetos}"
                        RowValidated="FirstLevelNestedGrid_RowValidated"
                        RowValidating="FirstLevelNestedGrid_RowValidating"
                        ShowGroupPanel="False">
                        <telerik:RadGridView.Columns>
                            <telerik:GridViewDataColumn Header="Dia" DataMemberBinding="{Binding dia}" IsReadOnly="True"/>
                            <telerik:GridViewDataColumn Header="Hora Minima" DataMemberBinding="{Binding hora_minima}" DataFormatString="{}{0:N2}"/>
                        </telerik:RadGridView.Columns>
                    </telerik:RadGridView>
                </DataTemplate>
            </telerik:RadGridView.RowDetailsTemplate>
        </telerik:RadGridView>
    </Grid>
</UserControl>
