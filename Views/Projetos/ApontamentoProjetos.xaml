<UserControl x:Class="Apontamento.Views.Projetos.ApontamentoProjetos"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Loaded="OnLoaded">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <telerik:RadWatermarkTextBox x:Name="nomeFuncionario" Grid.Column="0" Grid.ColumnSpan="4" Margin="5" IsEnabled="False" WatermarkContent="Nome"/>
        <telerik:RadWatermarkTextBox x:Name="funcaoFuncionario" Grid.Column="4" Grid.ColumnSpan="3" Margin="5" IsEnabled="False" WatermarkContent="Funcao"/>

        <telerik:RadComboBox
            x:Name="cmbIdTarefa"
            Grid.Column="0"
            Grid.Row="1"
            Margin="5"
            DisplayMemberPath="Key"
            IsEditable="True"
            IsTextSearchEnabled="True"
            ItemsSource="{Binding CentroCustos}"
            OpenDropDownOnFocus="True"
            SelectionChanged="OncmbIdTarefaSelectionChanged"
            EmptyText="Centro de Custo"/>

        <telerik:RadComboBox
            x:Name="cmbAtividade"
            Grid.Column="1"
            Grid.Row="1"
            Margin="5"
            DisplayMemberPath="atividade"
            IsEditable="True"
            IsTextSearchEnabled="True"
            ItemsSource="{Binding Atividades}"
            SelectedItem="{Binding Atividade, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            OpenDropDownOnFocus="True"
            SelectionChanged="OncmbAtividadeSelectionChanged"
            EmptyText="Atividade"/>

        <telerik:RadComboBox
            x:Name="centroCustoApontamento"
            Grid.Column="2"
            Grid.ColumnSpan="2"
            Grid.Row="1"
            Margin="5"
            IsEditable="True"
            IsTextSearchEnabled="True"
            OpenDropDownOnFocus="True"
            SelectionChanged="OncentroCustoApontamentoSelectionChanged"
            EmptyText="Cliente / Tema"/>

        <telerik:RadDatePicker
            x:Name="dataApontamento"
            Grid.Column="4"
            Grid.Row="1"
            Margin="5"
            SelectionChanged="dataApontamento_SelectionChanged"/>

        <telerik:RadNumericUpDown
            x:Name="totalHora"
            Grid.Column="5"
            Grid.Row="1"
            Margin="5"
            NumberDecimalDigits="2"
            Minimum="0"/>

        <telerik:RadWatermarkTextBox
            x:Name="DescricaoAtividade"
            Grid.Column="0"
            Grid.ColumnSpan="4"
            Grid.Row="2"
            Margin="5"
            IsEnabled="False"
            TextWrapping="Wrap"
            WatermarkContent="Descricao Atividade"/>

        <telerik:RadWatermarkTextBox
            x:Name="observacao"
            Grid.Column="4"
            Grid.ColumnSpan="2"
            Grid.Row="2"
            Margin="5"
            WatermarkContent="Observacao"/>

        <telerik:RadButton
            x:Name="buttonAdv"
            Grid.Row="2"
            Grid.Column="6"
            Width="80"
            HorizontalAlignment="Left"
            Content="GRAVAR"
            Click="OnApontarHoraClick"/>

        <telerik:RadGridView
            Grid.Column="0"
            Grid.ColumnSpan="4"
            Grid.Row="3"
            AutoGenerateColumns="False"
            CanUserResizeColumns="True"
            CanUserReorderColumns="True"
            IsFilteringAllowed="True"
            ItemsSource="{Binding HorasApontadas}"
            SelectedItem="{Binding HoraApontada, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            RowValidated="OnRowValidated"
            ShowGroupPanel="False">
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn Header="Atividade" DataMemberBinding="{Binding desc_atividade}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="Cliente / Tema" DataMemberBinding="{Binding cliente_tema}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="Data" DataMemberBinding="{Binding data}" DataFormatString="{}{0:dd/MM/yyyy}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="Semana" DataMemberBinding="{Binding semana}" DataFormatString="{}{0:N0}" IsReadOnly="True"/>
                <telerik:GridViewDataColumn Header="Hora" DataMemberBinding="{Binding hora_trabalhada}" DataFormatString="{}{0:N2}"/>
                <telerik:GridViewDataColumn Header="Observacao" DataMemberBinding="{Binding observacao}"/>
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>

        <telerik:RadGridView
            Grid.Column="4"
            Grid.ColumnSpan="3"
            Grid.Row="3"
            AutoGenerateColumns="False"
            CanUserResizeColumns="True"
            CanUserReorderColumns="True"
            ItemsSource="{Binding FuroProjetos}"
            IsReadOnly="True"
            ShowGroupPanel="False">
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn Header="Data" DataMemberBinding="{Binding data}" DataFormatString="{}{0:dd/MM/yyyy}"/>
                <telerik:GridViewDataColumn Header="Dia" DataMemberBinding="{Binding dia}"/>
                <telerik:GridViewDataColumn Header="Ideal" DataMemberBinding="{Binding hora_minima}" DataFormatString="{}{0:N2}"/>
                <telerik:GridViewDataColumn Header="Total" DataMemberBinding="{Binding hora_trabalhada}" DataFormatString="{}{0:N2}"/>
                <telerik:GridViewDataColumn Header="Furo" DataMemberBinding="{Binding validacao_novo}" DataFormatString="{}{0:N2}"/>
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>
    </Grid>
</UserControl>
